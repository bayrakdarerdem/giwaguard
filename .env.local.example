# GIWA contract (already deployed + verified — see README)
NEXT_PUBLIC_ESCROW_ADDRESS=0xfF03db8A28e248fdc5502001eBBdBE9dec771ae0

# Demo wallets — for the MVP demo, GiwaGuard signs transactions server-side
# using these two private keys (client = job poster, freelancer = worker).
# This mirrors freelance-arc's use of fixed CLIENT_WALLET_ADDRESS /
# FREELANCER_WALLET_ADDRESS demo accounts. A production version should use
# real wallet connect (MetaMask) instead of server-held keys.
# NEVER commit this file or share these keys — testnet-only wallets, no real funds.
CLIENT_PRIVATE_KEY=0x...
FREELANCER_PRIVATE_KEY=0x...
FREELANCER_WALLET_ADDRESS=0x...

# Supabase (same project/schema as freelance-arc's `jobs` and `applications` tables)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
